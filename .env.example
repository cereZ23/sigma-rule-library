# GitHub Pages deployment configuration (docs/SPEC.md §14)

# Origin of the deployed site (no trailing slash)
PUBLIC_SITE_URL=https://username.github.io

# Base path. For a project page use "/<repository-name>", for a user/root page use ""
PUBLIC_BASE_PATH=/sigma-rule-library

# "owner/name" of the repository hosting this site (used for links in the UI)
PUBLIC_GITHUB_REPOSITORY=username/sigma-rule-library
