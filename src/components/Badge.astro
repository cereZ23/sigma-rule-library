---
/**
 * Consistent badge for level / status / logsource / generic values.
 * Colors never carry meaning alone: the label text is always shown.
 */
interface Props {
  label: string;
  kind?: 'level' | 'status' | 'neutral' | 'accent';
  value?: string;
  title?: string;
}

const { label, kind = 'neutral', value = label, title } = Astro.props;

const levelColors: Record<string, string> = {
  critical: 'bg-red-100 text-red-900 dark:bg-red-950 dark:text-red-300 border-red-200 dark:border-red-900',
  high: 'bg-orange-100 text-orange-900 dark:bg-orange-950 dark:text-orange-300 border-orange-200 dark:border-orange-900',
  medium: 'bg-amber-100 text-amber-900 dark:bg-amber-950 dark:text-amber-300 border-amber-200 dark:border-amber-900',
  low: 'bg-sky-100 text-sky-900 dark:bg-sky-950 dark:text-sky-300 border-sky-200 dark:border-sky-900',
  informational: 'bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700',
};

const statusColors: Record<string, string> = {
  stable: 'bg-emerald-100 text-emerald-900 dark:bg-emerald-950 dark:text-emerald-300 border-emerald-200 dark:border-emerald-900',
  test: 'bg-blue-100 text-blue-900 dark:bg-blue-950 dark:text-blue-300 border-blue-200 dark:border-blue-900',
  experimental: 'bg-purple-100 text-purple-900 dark:bg-purple-950 dark:text-purple-300 border-purple-200 dark:border-purple-900',
  deprecated: 'bg-zinc-100 text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400 border-zinc-200 dark:border-zinc-700',
  unsupported: 'bg-zinc-100 text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400 border-zinc-200 dark:border-zinc-700',
};

const fallback = 'bg-surface-muted text-body-muted border-edge';
const accent = 'bg-accent-soft text-link border-edge';

const colorClass =
  kind === 'level'
    ? (levelColors[value.toLowerCase()] ?? fallback)
    : kind === 'status'
      ? (statusColors[value.toLowerCase()] ?? fallback)
      : kind === 'accent'
        ? accent
        : fallback;
---

<span
  title={title}
  class:list={[
    'inline-flex items-center whitespace-nowrap rounded-full border px-2 py-0.5 text-xs font-medium',
    colorClass,
  ]}>{label}</span
>
