---
/**
 * Shared body for the taxonomy landing pages: breadcrumb, heading, a short
 * unique intro, a related-links block for internal linking, and the rule list.
 * Wraps BaseLayout so each taxonomy page is a thin data-only wrapper.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import RuleCard from './RuleCard.astro';
import { href } from '../lib/site';
import type { RuleCardData } from '../lib/taxonomy';

interface RelatedGroup {
  heading: string;
  links: { label: string; href: string; count?: number }[];
}

interface Props {
  /** Small kind label above the title, e.g. "MITRE ATT&CK technique". */
  kind: string;
  title: string;
  code?: string;
  /** Site-relative path of this page (for canonical/og). */
  path: string;
  /** <=160 char meta description. */
  description: string;
  /** Visible intro paragraph (unique per page). */
  intro: string;
  externalLink?: { href: string; label: string };
  rules: RuleCardData[];
  related?: RelatedGroup[];
}

const { kind, title, code, path, description, intro, externalLink, rules, related = [] } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${title} — Sigma detection rules`,
  description,
  url: `https://cerez23.github.io${href(path)}`,
  isPartOf: { '@type': 'WebSite', name: 'Sigma Rule Library', url: href('/') },
};
---

<BaseLayout title={title} description={description} path={path} jsonLd={jsonLd}>
  <nav aria-label="Breadcrumb" class="mb-4 text-sm text-body-subtle">
    <ol class="flex flex-wrap items-center gap-1.5">
      <li><a href={href('/')} class="hover:text-link hover:underline">Home</a></li>
      <li aria-hidden="true">/</li>
      <li><a href={href('/library/')} class="hover:text-link hover:underline">Library</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page" class="text-body-muted">{title}</li>
    </ol>
  </nav>

  <header class="mb-6 max-w-3xl">
    <p class="text-xs font-semibold uppercase tracking-wide text-body-subtle">{kind}</p>
    <h1 class="mt-1 text-2xl font-bold text-body sm:text-3xl">
      {title}
      {code && <span class="ml-2 font-mono text-lg text-body-subtle">{code}</span>}
    </h1>
    <p class="mt-3 text-body-muted">{intro}</p>
    <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm">
      {
        externalLink && (
          <a
            href={externalLink.href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-link underline decoration-edge-strong underline-offset-2 hover:decoration-current"
          >
            {externalLink.label}
          </a>
        )
      }
      <span class="text-body-subtle">{rules.length} rule{rules.length === 1 ? '' : 's'}</span>
    </div>
  </header>

  {
    related.length > 0 && (
      <div class="mb-6 flex flex-col gap-3 border-y border-edge py-4 sm:flex-row sm:flex-wrap sm:gap-8">
        {related.map((group) => (
          <div>
            <h2 class="text-xs font-semibold uppercase tracking-wide text-body-subtle">
              {group.heading}
            </h2>
            <ul class="mt-1.5 flex flex-wrap gap-1.5">
              {group.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="inline-flex items-center gap-1 rounded-full border border-edge bg-surface-elevated px-2.5 py-0.5 text-xs text-body hover:border-edge-strong"
                  >
                    {link.label}
                    {link.count != null && <span class="text-body-subtle">{link.count}</span>}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    )
  }

  <ul class="grid list-none gap-3 p-0 sm:grid-cols-2 xl:grid-cols-3">
    {
      rules.map((rule) => (
        <li>
          <RuleCard
            slug={rule.slug}
            title={rule.title}
            description={rule.description}
            level={rule.level}
            product={rule.product}
            note={rule.note}
          />
        </li>
      ))
    }
  </ul>
</BaseLayout>
