---
import BaseLayout from '../layouts/BaseLayout.astro';
import stats from '../generated/stats.json';
import indexUrl from '../generated/library-index.json?url';
import indexData from '../generated/library-index.json';
import type { LibraryRecord } from '../lib/library-types';
import { sortRecords } from '../lib/search';
import { BASE_PATH, href } from '../lib/site';
import { rulePath } from '../lib/urls';

const description = `Search and filter ${stats.totalRules.toLocaleString('en-US')} community-maintained Sigma detection rules by product, log source, severity, status and MITRE ATT&CK.`;

// Progressive enhancement: the first page of results is prerendered at build
// time (default sort: recently modified), so the library is useful before —
// or without — JavaScript. The client app replaces this list once the search
// index loads. Card markup must stay in sync with ruleCard() in
// src/scripts/library-app.ts.
const initialRecords = sortRecords(indexData as LibraryRecord[], 'modified').slice(0, 24);
const totalCount = (indexData as LibraryRecord[]).length;

const LEVEL_BADGE: Record<string, string> = {
  critical: 'bg-red-100 text-red-900 dark:bg-red-950 dark:text-red-300',
  high: 'bg-orange-100 text-orange-900 dark:bg-orange-950 dark:text-orange-300',
  medium: 'bg-amber-100 text-amber-900 dark:bg-amber-950 dark:text-amber-300',
  low: 'bg-sky-100 text-sky-900 dark:bg-sky-950 dark:text-sky-300',
  informational: 'bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300',
};
const badgeClass = (extra: string) =>
  `inline-flex items-center whitespace-nowrap rounded-full px-2 py-0.5 text-xs font-medium ${extra}`;
---

<BaseLayout title="Rule Library" description={description} path="/library/">
  <div id="library-app" data-index-url={indexUrl} data-base={BASE_PATH}>
    <header class="mb-6">
      <h1 class="text-2xl font-bold text-body sm:text-3xl">Rule Library</h1>
      <p class="mt-1 text-body-muted">
        Search across titles, descriptions, IDs, authors, tags, ATT&amp;CK techniques, log sources and
        detection values. Filters combine, and the URL always reflects your current search.
      </p>
    </header>

    <div class="mb-4 flex flex-wrap items-center gap-3">
      <label for="library-search" class="sr-only">Search rules</label>
      <input
        id="library-search"
        type="search"
        placeholder="Search rules, e.g. powershell, T1059, lsass…"
        class="min-w-0 flex-1 rounded-lg border border-edge bg-surface-elevated px-4 py-2.5 text-body placeholder:text-body-subtle"
        autocomplete="off"
      />
      <label for="library-sort" class="sr-only">Sort results</label>
      <select
        id="library-sort"
        class="rounded-lg border border-edge bg-surface-elevated px-3 py-2.5 text-sm text-body"
      ></select>
      <button
        id="filters-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="filter-panel"
        class="rounded-lg border border-edge bg-surface-elevated px-4 py-2.5 text-sm font-medium text-body hover:bg-surface-muted lg:hidden"
      >
        Filters
      </button>
    </div>

    <p id="result-count" role="status" aria-live="polite" class="mb-4 text-sm text-body-muted">
      {totalCount.toLocaleString('en-US')} rules found
    </p>
    <p id="library-status" class="mb-4 text-sm text-body-muted">
      <noscript>
        JavaScript is disabled: showing the {initialRecords.length} most recently modified rules.
        Search and filters require JavaScript.
      </noscript>
    </p>

    <div class="grid gap-8 lg:grid-cols-[16rem_1fr]">
      <aside
        id="filter-panel"
        class="fixed inset-0 z-50 hidden overflow-y-auto bg-surface p-4 data-open:block lg:static lg:z-auto lg:block lg:overflow-visible lg:bg-transparent lg:p-0"
        aria-label="Filters"
      >
        <div class="mb-3 flex items-center justify-between">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-body-subtle">Filters</h2>
          <div class="flex items-center gap-2">
            <button id="clear-filters" type="button" class="text-sm text-link hover:underline">
              Clear filters
            </button>
            <button
              id="filters-close"
              type="button"
              class="rounded-md border border-edge px-2 py-1 text-sm text-body lg:hidden"
              aria-label="Close filters"
            >
              Close
            </button>
          </div>
        </div>
        <form id="filter-form" aria-label="Filter groups"></form>
      </aside>

      <section aria-label="Search results" class="min-w-0">
        <ul id="results-list" class="grid list-none gap-3 p-0 sm:grid-cols-2 xl:grid-cols-3">
          {
            initialRecords.map((record) => (
              <li>
                <a
                  href={href(rulePath(record.slug))}
                  class="block h-full rounded-lg border border-edge bg-surface-elevated p-4 transition-colors hover:border-edge-strong"
                >
                  <div class="flex items-start justify-between gap-3">
                    <h3 class="font-medium leading-snug text-body">{record.title}</h3>
                    <span
                      class={badgeClass(
                        LEVEL_BADGE[record.level] ?? 'bg-surface-muted text-body-muted',
                      )}
                    >
                      {record.level}
                    </span>
                  </div>
                  {record.description && (
                    <p class="mt-1.5 line-clamp-2 text-sm text-body-muted">{record.description}</p>
                  )}
                  <div class="mt-3 flex flex-wrap gap-1.5">
                    <span class={badgeClass('bg-surface-muted text-body-muted')}>{record.status}</span>
                    {record.product && (
                      <span class={badgeClass('bg-accent-soft text-link')}>{record.product}</span>
                    )}
                    {(record.service ?? record.category) && (
                      <span class={badgeClass('bg-accent-soft text-link')}>
                        {record.service ?? record.category}
                      </span>
                    )}
                    {record.techniques
                      .filter((t) => !t.includes('.'))
                      .slice(0, 3)
                      .map((technique) => (
                        <span class={badgeClass('bg-surface-muted font-mono text-body-muted')}>
                          {technique}
                        </span>
                      ))}
                    <span class={badgeClass('bg-surface-muted text-body-muted')}>{record.section}</span>
                  </div>
                  {(record.authors.length > 0 || record.modified) && (
                    <p class="mt-2 text-xs text-body-subtle">
                      {[
                        record.authors.length > 0
                          ? record.authors[0] + (record.authors.length > 1 ? ' et al.' : '')
                          : null,
                        record.modified ? `modified ${record.modified}` : null,
                      ]
                        .filter(Boolean)
                        .join(' · ')}
                    </p>
                  )}
                </a>
              </li>
            ))
          }
        </ul>
        <nav id="pagination" aria-label="Pagination" class="mt-6 flex items-center justify-center gap-3"></nav>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  import { initLibraryApp } from '../scripts/library-app';
  initLibraryApp(document.querySelector<HTMLElement>('#library-app')!);
</script>
